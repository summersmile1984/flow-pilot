onlyBuiltDependencies:
  - node-pty

# Flat, npm-style node_modules instead of pnpm's symlinked default.
#
# electron-builder's dependency collector mishandles pnpm's aliased packages:
# @mastra/core pins several ai-sdk majors side by side via aliases
# (@ai-sdk/provider-utils-v5 -> npm:@ai-sdk/provider-utils@3.0.25, and ~15 more).
# It copies the aliased directory into the asar but resolves that package's own
# dependencies under the alias name, so nested deps are silently dropped — the
# packaged app then died at startup with "Cannot find module
# '@standard-schema/spec'".
#
# A hoisted layout sidesteps the alias walk entirely. The trade-off is losing
# pnpm's strict isolation, so undeclared (phantom) dependencies no longer fail
# fast at install time.
node-linker=hoisted

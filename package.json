{
  "name": "flow-pilot",
  "version": "0.1.0",
  "productName": "Flow Pilot",
  "description": "Flow Pilot — unified management for Claude Code, Codex, and any ACP agent via Mastra",
  "author": {
    "name": "Dejan Zegarac",
    "email": "dejanzegarac3@gmail.com"
  },
  "license": "MIT",
  "main": "electron/dist/main.js",
  "scripts": {
    "build:electron": "tsup --config tsup.electron.config.ts",
    "dev": "concurrently \"vite\" \"pnpm build:electron --watch\" \"node scripts/delay.js 3 && cross-env ELECTRON_ENABLE_LOGGING=1 electron .\"",
    "build": "pnpm build:electron && vite build",
    "start": "electron .",
    "dist": "pnpm build && electron-builder --config electron-builder.config.js",
    "dist:fast": "pnpm build && electron-builder --config electron-builder.config.js --dir",
    "dist:mac": "pnpm build && electron-builder --mac --config electron-builder.config.js",
    "verify:asar": "node scripts/verify-asar.cjs \"release/$npm_package_version/mac-arm64/Flow Pilot.app/Contents/Resources/app.asar\"",
    "dist:win": "pnpm build && electron-builder --win --config electron-builder.config.js",
    "dist:linux": "pnpm build && electron-builder --linux --config electron-builder.config.js",
    "postinstall": "node -e \"require('child_process').execSync('electron-rebuild'+(process.platform==='darwin'?'':' --ignore electron-liquid-glass'),{stdio:'inherit'})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=electron",
    "test:e2e:dev": "PILOT_DEV_PORT=5180 playwright test --project=electron"
  },
  "packageManager": "pnpm@10.26.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.15.0",
    "@anthropic-ai/claude-agent-sdk": "^0.2.101",
    "@huggingface/transformers": "^3.8.1",
    "@mastra/acp": "^0.3.0",
    "@mastra/core": "^1.49.0",
    "@mastra/libsql": "^1.15.0",
    "@mastra/memory": "^1.22.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@monaco-editor/react": "^4.7.0",
    "@posthog/react": "^1.8.2",
    "@standard-schema/spec": "1.1.0",
    "@tanstack/react-virtual": "^3.13.22",
    "chart.js": "^4.5.1",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.3.3",
    "electron-context-menu": "^4.1.1",
    "electron-liquid-glass": "github:darkkatarsis/electron-liquid-glass",
    "electron-updater": "^6.8.3",
    "i18next": "^26.3.6",
    "js-yaml": "^5.2.1",
    "jszip": "^3.10.1",
    "konva": "^10.2.0",
    "mermaid": "^11.13.0",
    "motion": "^12.34.3",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "posthog-js": "^1.360.0",
    "posthog-node": "^4.3.1",
    "pptxviewjs": "^1.1.9",
    "react-i18next": "^17.0.10",
    "react-konva": "^19.2.3",
    "refractor": "^5.0.0",
    "sonner": "^2.0.7",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.2.0",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "diff": "^8.0.3",
    "electron": "^40.4.0",
    "electron-builder": "^26.8.1",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^3.8.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
